# Per-developer / per-worktree overrides. Copy to .env.local (gitignored) and
# edit. Loaded after .env by the Docker dev stack (see `env_file:` in
# docker-compose.fullapp.dev.yml) and by Next.js when running on the host, so
# every value here wins over the same key in .env.
#
# Container-network settings (DATABASE_URL, REDIS_URL, MEILISEARCH_HOST, ...)
# are pinned in the compose file and cannot be overridden here.

# --- Serving the app over an OrbStack domain ---------------------------------
# The dev stack publishes no host ports, so the app is reached through the
# OrbStack container domain: http://<service>.<compose-project>.orb.local
# The compose project name defaults to the directory name, so each worktree gets
# its own domain (fondaco -> app.fondaco.orb.local, fondaco-foo ->
# app.fondaco-foo.orb.local).
#
# APP_URL is the browser-facing base URL used for links and origin allowlists.
APP_URL=http://app.fondaco.orb.local

# Extra hostnames trusted by the Next.js dev-origin allowlist
# (resolveAllowedDevOrigins -> next.config.ts allowedDevOrigins). Without a
# matching entry Next blocks /_next/* and the HMR WebSocket with
# "Blocked cross-origin request to Next.js dev resource".
# `**.orb.local` matches every OrbStack domain, so it covers every worktree and
# needs no edit when the project directory is renamed.
APP_ALLOWED_ORIGINS=**.orb.local

# Browser origins allowed to open the documents collaboration WebSocket
# (`--profile documents-collab`). Exact origins only, no wildcards.
DOCUMENTS_COLLAB_ALLOWED_ORIGINS=http://app.fondaco.orb.local

# Browser-facing URL of the collaboration server, when it is running.
# NEXT_PUBLIC_DOCUMENTS_COLLAB_URL=ws://documents-collab.fondaco.orb.local

# --- Local notification email -----------------------------------------------
# No outbound email provider module is enabled in a dev worktree, so anything the
# notifications module would email - a role assignment, a user invite, a password
# reset - throws EMAIL_TRANSPORT_NOT_CONFIGURED and shows up as a runtime error in
# the dev overlay. The underlying operation still succeeds and the in-app
# notification still lands. Remove this line to exercise real email delivery.
OM_DISABLE_EMAIL_DELIVERY=1

# --- Demo warehouseman -------------------------------------------------------
# `mercato init` (without --no-examples) seeds a warehouseman so the panel can be
# opened immediately. Setting this prints those credentials on /warehouseman/login.
# It is refused outright when NODE_ENV is production, so it can only ever advertise
# a throwaway environment. Override the account with OM_INIT_WAREHOUSEMAN_EMAIL /
# OM_INIT_WAREHOUSEMAN_PASSWORD.
OM_SHOW_DEMO_CREDENTIALS=1
